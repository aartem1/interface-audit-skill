{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interface audit report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "audit_id",
    "created_at",
    "target",
    "scope",
    "cases",
    "checks",
    "findings"
  ],
  "properties": {
    "format_version": {"const": 1},
    "audit_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "identity", "kind", "location", "revision", "environment"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "included", "excluded", "assumptions", "limits"],
      "properties": {
        "mode": {"enum": ["targeted", "whole_accessible"]},
        "included": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "limits": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "goal", "context", "coverage", "reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^CASE-[0-9]{3,}$"},
        "target": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "context": {"type": "object"},
        "coverage": {"enum": ["exercised", "partial", "not_exercised", "excluded"]},
        "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"coverage": {"const": "exercised"}}, "required": ["coverage"]},
          "then": {"properties": {"reason": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"coverage": {"enum": ["partial", "not_exercised", "excluded"]}},
            "required": ["coverage"]
          },
          "then": {"properties": {"reason": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_id",
        "criterion_id",
        "subject",
        "status",
        "verdict",
        "steps",
        "expected",
        "observed",
        "evidence",
        "reason"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^C-[0-9]{3,}$"},
        "case_id": {"type": "string", "pattern": "^CASE-[0-9]{3,}$"},
        "criterion_id": {
          "type": "string",
          "pattern": "^(?:[A-Z]+-[0-9]{2,}|LOCAL-[A-Z0-9]+(?:-[A-Z0-9]+)*)$"
        },
        "criterion_source": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "status": {"enum": ["checked", "not_applicable", "not_checked"]},
        "verdict": {"type": ["boolean", "null"]},
        "steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "expected": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "observed": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"criterion_id": {"type": "string", "pattern": "^LOCAL-"}},
            "required": ["criterion_id"]
          },
          "then": {"required": ["criterion_source"]}
        },
        {
          "if": {"properties": {"status": {"const": "checked"}}, "required": ["status"]},
          "then": {
            "properties": {
              "verdict": {"type": "boolean"},
              "steps": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "expected": {"type": "string", "minLength": 1},
              "observed": {"type": "string", "minLength": 1},
              "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
              "reason": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"enum": ["not_applicable", "not_checked"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {"verdict": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "severity", "impact", "check_ids", "acceptance", "fix"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "impact": {"type": "string", "minLength": 1},
        "check_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^C-[0-9]{3,}$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "history"],
          "properties": {
            "status": {
              "enum": ["open", "blocked", "implemented_unverified", "fixed", "not_reproduced"]
            },
            "history": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {"enum": ["blocked", "implemented_unverified", "fixed", "not_reproduced"]}
                },
                "required": ["status"]
              },
              "then": {"properties": {"history": {"minItems": 1}}}
            }
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "status", "revision", "environment", "changes", "verification", "note"],
      "properties": {
        "at": {"type": "string", "format": "date-time", "pattern": "Z$"},
        "status": {"enum": ["open", "blocked", "implemented_unverified", "fixed", "not_reproduced"]},
        "revision": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "environment": {"type": "string", "minLength": 1},
        "changes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verification": {"type": "array", "items": {"$ref": "#/$defs/verification"}},
        "note": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"enum": ["blocked", "implemented_unverified"]}},
            "required": ["status"]
          },
          "then": {"properties": {"note": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {
            "properties": {"status": {"enum": ["fixed", "not_reproduced"]}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "verification": {"minItems": 1, "items": {"properties": {"result": {"const": "pass"}}}}
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "result", "evidence"],
      "properties": {
        "check": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "not_run"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"enum": ["pass", "fail"]}}, "required": ["result"]},
          "then": {
            "properties": {
              "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            }
          }
        }
      ]
    }
  }
}
